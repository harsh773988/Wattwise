# WattWise Environment Configuration
# When Supabase variables are empty, WattWise automatically runs in MemoryRepository demo mode.

# Supabase (Postgres) Configuration (Optional - demo runs without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API Rate Limiter Configuration
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ==============================================================================
# WattWise Environment Configuration
# ==============================================================================
# Note: If Supabase credentials are left empty, WattWise automatically runs in
# MemoryRepository demo mode with zero external dependencies.

# Supabase Authentication and Postgres Configuration (Optional for demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Server-only key used by the private repository. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Site and SEO Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
CONTACT_EMAIL=you@example.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=you@example.com

# Shared administrator key for the aggregate-only /admin view.
# Set a strong secret in deployment settings; never use a NEXT_PUBLIC_ variable.
# ADMIN_KEY=replace-with-a-long-random-secret

# API Rate Limiter Configuration
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
